# URL devuelta por `npm run worker:deploy`.
EXPO_PUBLIC_STORY_API_URL=https://el-jardin-secreto-family.tu-subdominio.workers.dev

# Mismo valor configurado con `npx wrangler secret put FAMILY_ACCESS_TOKEN`.
# Es una credencial familiar revocable; no concede acceso a la cuenta de Cloudflare.
EXPO_PUBLIC_FAMILY_ACCESS_TOKEN=reemplaza_con_un_token_largo_y_aleatorio
